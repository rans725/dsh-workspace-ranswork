{
  "name": "dsh-workspace-ranswork",
  "version": "0.4.1",
  "type": "module",
  "description": "Workspace overview for DeepSeek Harness: a sidebar panel that switches between running tasks and all conversations, shown as one freely sortable card list, with per-card actions (pin / rename / copy id / fork / stop / archive).",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "rans725",
  "homepage": "https://github.com/rans725/dsh-workspace-ranswork#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rans725/dsh-workspace-ranswork.git"
  },
  "bugs": {
    "url": "https://github.com/rans725/dsh-workspace-ranswork/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "workspace",
    "sessions",
    "running-tasks",
    "sidebar",
    "overview"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
